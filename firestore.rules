rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /settings/{docId} {
      allow read, write: if signedIn();
    }

    match /licenses/{licenseId} {
      allow read, create, update, delete: if signedIn();
    }
  }
}

